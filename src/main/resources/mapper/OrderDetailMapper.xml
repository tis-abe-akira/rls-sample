<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rlssample.order.OrderDetailMapper">

    <resultMap id="orderDetailMap" type="com.example.rlssample.order.OrderDetail">
        <constructor>
            <idArg column="id"         javaType="java.lang.Long"/>
            <arg   column="tenant_id"  javaType="java.lang.Long"/>
            <arg   column="order_id"   javaType="java.lang.Long"/>
            <arg   column="item"       javaType="java.lang.String"/>
            <arg   column="quantity"   javaType="java.lang.Integer"/>
            <arg   column="unit_price" javaType="java.lang.Integer"/>
        </constructor>
    </resultMap>

    <!-- ✅ 子テーブルでも tenant_id で絞る -->
    <select id="findByOrderId" resultMap="orderDetailMap">
        SELECT id, tenant_id, order_id, item, quantity, unit_price
          FROM order_details
         WHERE tenant_id = #{tenantId}
           AND order_id  = #{orderId}
         ORDER BY id
    </select>

    <!-- ❌ WHERE句の書き忘れ。RLS が無ければ全社・全員の明細が返る -->
    <select id="findAllWithoutTenantFilter" resultMap="orderDetailMap">
        SELECT id, tenant_id, order_id, item, quantity, unit_price
          FROM order_details
         ORDER BY id
    </select>

    <select id="insert" resultType="long" flushCache="true">
        INSERT INTO order_details (tenant_id, order_id, item, quantity, unit_price)
        VALUES (#{tenantId}, #{orderId}, #{item}, #{quantity}, #{unitPrice})
        RETURNING id
    </select>

</mapper>
